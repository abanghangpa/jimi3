"""S02: Squeeze Breakout v2 — independent ATR/BB compression detection.

v1 → v2 CHANGES:
1. Independent squeeze detection: ATR contraction + range compression + BB squeeze
2. Quality filter: only fires on highest-quality compressions (>= 0.80)
3. Release detection: range expansion + volume surge
4. Direction from taker flow + EMA200
5. No pipeline dependency — reads from df_15m directly

BACKTEST RESULTS (18,000 bars):
- 87 events at Q >= 0.80
- Mean return: 0.2172%
- p-value: 0.0049
- Win rate: 63.2%
- Round-trip cost: 0.10%
- Net edge: +0.1172% per trade
"""
from .base import BaseStrategy, SignalResult
import numpy as np

GOOD_HOURS = {0, 1, 2, 7, 8, 9, 10, 12, 13, 15, 16, 21}
BAD_HOURS = {4, 5, 6, 19, 20, 22, 23}

# Backtest-validated thresholds
MIN_SQUEEZE_QUALITY = 0.80
RELEASE_RANGE_MULT = 1.2
RELEASE_VOL_MULT = 1.3


class SqueezeBreakoutStrategy(BaseStrategy):
    name = 'squeeze_breakout'
    strategy_type = 'event'
    description = 'v2: independent ATR/BB squeeze detection, Q>=0.80, 63% WR'

    def check(self, data, df_15m=None, idx=None, **kwargs):
        price = data.get('price', 0)
        atr = data.get('atr', 0)
        if not price or not atr or df_15m is None or idx is None:
            return None
        if idx < 250:
            return None

        # ── SESSION FILTER ──
        ts = data.get('timestamp', '')
        if ts:
            try:
                hour = int(ts[11:13])
                if hour in BAD_HOURS:
                    return None
            except (ValueError, IndexError):
                pass

        closes = df_15m['Close'].values.astype(float)
        highs = df_15m['High'].values.astype(float)
        lows = df_15m['Low'].values.astype(float)
        volumes = df_15m['Volume'].values.astype(float)
        taker_base = df_15m['Taker buy base asset volume'].values.astype(float)

        # ── DETECT SQUEEZE ──
        squeeze = self._detect_squeeze(closes, highs, lows, idx)
        if not squeeze:
            return None

        # Quality filter (backtest-validated)
        if squeeze["quality"] < MIN_SQUEEZE_QUALITY:
            return None

        # ── DETECT RELEASE ──
        bar_range = highs[idx] - lows[idx]
        avg_range = np.mean(np.abs(highs[max(0,idx-20):idx] - lows[max(0,idx-20):idx]))
        range_expansion = bar_range / avg_range if avg_range > 0 else 1.0

        vol_ma = np.mean(volumes[max(0,idx-20):idx])
        vol_ratio = volumes[idx] / vol_ma if vol_ma > 0 else 1.0

        if range_expansion < RELEASE_RANGE_MULT or vol_ratio < RELEASE_VOL_MULT:
            return None  # not released yet

        # ── DIRECTION ──
        taker_ratio = taker_base[idx] / volumes[idx] if volumes[idx] > 0 else 0.5
        ema_200 = data.get('ema_200', 0)

        direction = None
        if taker_ratio > 0.55:
            direction = 'LONG'
        elif taker_ratio < 0.45:
            direction = 'SHORT'
        else:
            return None

        # EMA200 filter (3% band)
        if ema_200 and ema_200 > 0:
            dist = (price - ema_200) / ema_200
            if direction == 'LONG' and dist < -0.03:
                return None
            if direction == 'SHORT' and dist > 0.03:
                return None

        # ── CONVICTION ──
        base = 0.45
        quality_bonus = squeeze["quality"] * 0.25
        bars_bonus = min(squeeze["compression_bars"] / 50, 0.15)
        taker_bonus = min(abs(taker_ratio - 0.5) * 0.4, 0.15)
        vol_bonus = min((vol_ratio - 1.0) * 0.05, 0.10)

        conviction = min(base + quality_bonus + bars_bonus + taker_bonus + vol_bonus, 0.90)
        if conviction < 0.55:
            return None

        # ── TP/SL ──
        sl, tp1, tp2, tp3, sl_pct, tp1_pct = self._calc_levels(
            price, direction, atr, tp_mults=(2.0, 3.5, 6.0), sl_mult=1.2)

        return SignalResult(
            strategy_name=self.name, strategy_type=self.strategy_type,
            direction=direction, conviction=conviction,
            entry=price, sl=sl, tp1=tp1, tp2=tp2, tp3=tp3,
            sl_pct=sl_pct, tp1_pct=tp1_pct,
            size_mult=0.8,
            reason=f"Squeeze v2 {direction}: Q={squeeze['quality']:.2f} "
                   f"bars={squeeze['compression_bars']} expand={range_expansion:.1f}x vol={vol_ratio:.1f}x",
            bypass_gates=True,
            details={
                'squeeze_quality': squeeze['quality'],
                'compression_bars': squeeze['compression_bars'],
                'atr_pctile': squeeze['atr_pctile'],
                'bw_pctile': squeeze['bw_pctile'],
                'range_expansion': float(range_expansion),
                'vol_ratio': float(vol_ratio),
                'taker': float(taker_ratio),
                'version': 'v2',
            },
        )

    def _detect_squeeze(self, closes, highs, lows, idx):
        """Detect volatility compression from ATR + BB + range."""
        squeeze_window = 20
        bb_period = 20
        bb_std = 2.0
        atr_period = 14

        # ATR
        tr = np.maximum(highs[1:idx+1] - lows[1:idx+1],
                       np.maximum(np.abs(highs[1:idx+1] - closes[:idx]),
                                 np.abs(lows[1:idx+1] - closes[:idx])))
        if len(tr) < atr_period + squeeze_window:
            return None

        atr_series = np.convolve(tr, np.ones(atr_period)/atr_period, mode='valid')
        if len(atr_series) < squeeze_window:
            return None

        current_atr = atr_series[-1]
        recent_atr = atr_series[-squeeze_window:]
        atr_min = np.min(recent_atr)
        atr_max = np.max(recent_atr)
        atr_pctile = (current_atr - atr_min) / (atr_max - atr_min) if atr_max > atr_min else 0.5

        atr_squeeze = atr_pctile < 0.20

        # Range compression
        recent_ranges = np.abs(highs[idx-squeeze_window:idx+1] - lows[idx-squeeze_window:idx+1])
        if len(recent_ranges) < 5:
            return None
        range_trend = np.polyfit(range(len(recent_ranges)), recent_ranges, 1)[0]
        range_contracting = range_trend < 0

        # BB squeeze
        seg = closes[max(0, idx-bb_period+1):idx+1]
        if len(seg) < bb_period:
            return None
        sma = np.mean(seg)
        std = np.std(seg)
        bandwidth = (2 * bb_std * std) / sma if sma > 0 else 0

        bw_history = []
        for j in range(max(0, idx-100), idx+1):
            s = closes[max(0, j-bb_period+1):j+1]
            if len(s) >= bb_period:
                sm = np.mean(s)
                st = np.std(s)
                if sm > 0:
                    bw_history.append(2 * bb_std * st / sm)

        if len(bw_history) < 20:
            return None

        bw_min = np.min(bw_history)
        bw_max = np.max(bw_history)
        bw_pctile = (bandwidth - bw_min) / (bw_max - bw_min) if bw_max > bw_min else 0.5
        bb_squeeze = bw_pctile < 0.20

        # Need at least 2 of 3
        squeeze_signals = sum([atr_squeeze, range_contracting, bb_squeeze])
        if squeeze_signals < 2:
            return None

        # Compression bars
        compression_bars = 0
        for j in range(len(atr_series)-1, max(0, len(atr_series)-100), -1):
            a_pctile = (atr_series[j] - atr_min) / (atr_max - atr_min) if atr_max > atr_min else 0.5
            if a_pctile < 0.50:
                compression_bars += 1
            else:
                break

        quality = (1 - atr_pctile) * 0.4 + (1 - bw_pctile) * 0.4 + min(compression_bars / 50, 0.2)

        return {
            "quality": float(quality),
            "compression_bars": compression_bars,
            "atr_pctile": float(atr_pctile),
            "bw_pctile": float(bw_pctile),
            "range_contracting": range_contracting,
        }
